---
import { getCollection } from 'astro:content';
import { formatDate, formatDateRange } from '../../utils/formatDate.js';

const artists = await getCollection('artists');

// Sort artists by name
const sortedArtists = artists.sort((a, b) => 
  a.data.name.localeCompare(b.data.name)
);

// Get painting counts for each artist
const paintings = await getCollection('paintings');
const paintingCounts = {};
paintings.forEach(painting => {
  paintingCounts[painting.data.artist] = (paintingCounts[painting.data.artist] || 0) + 1;
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>All Artists - Art Gallery</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/">← Back to Home</a>
      </nav>
      <h1>All Artists</h1>
      <p class="subtitle">{artists.length} artists in the collection</p>
    </header>

    <main>
      <div class="artists-grid">
        {sortedArtists.map(artist => (
          <div class="artist-card">
            <a href={`/artists/${artist.data.id}`}>
              {artist.data.image ? (
                <img src={artist.data.image} alt={artist.data.name} />
              ) : (
                <div class="no-image">
                  <span class="icon">🎨</span>
                </div>
              )}
              <div class="artist-info">
                <h2>{artist.data.name}</h2>
                <p class="dates">{formatDateRange(artist.data.birthDate, artist.data.deathDate, 'year')}</p>
                <p class="painting-count">
                  {paintingCounts[artist.data.id] || 0} painting{paintingCounts[artist.data.id] !== 1 ? 's' : ''}
                </p>
              </div>
            </a>
          </div>
        ))}
      </div>
    </main>
  </body>
</html>

<style>
  body {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  header {
    margin-bottom: 3rem;
  }

  nav {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .artists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .artist-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .artist-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 8px 24px var(--shadow);
  }

  .artist-card a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .artist-card img,
  .no-image {
    width: 100%;
    height: 280px;
    object-fit: cover;
  }

  .no-image {
    background: var(--bg-tertiary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .no-image .icon {
    font-size: 4rem;
    opacity: 0.3;
  }

  .artist-info {
    padding: 1.5rem;
  }

  .artist-info h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.3rem;
    color: var(--text-primary);
  }

  .dates {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0 0 0.5rem 0;
  }

  .painting-count {
    color: var(--accent);
    font-size: 0.9rem;
    margin: 0;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    .artists-grid {
      grid-template-columns: 1fr;
    }
  }
</style>