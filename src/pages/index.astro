---
import { getCollection } from 'astro:content';
import { formatDate, formatDateRange } from '../utils/formatDate.js';
import '../styles/global.css';  // Add this import

const paintings = await getCollection('paintings');
const artists = await getCollection('artists');
const featuredPaintings = paintings.filter(p => p.data.featured);

const artistMap = Object.fromEntries(
  artists.map(artist => [artist.data.id, artist.data.name])
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Art Gallery - Home</title>
  </head>
  <body>
    <header>
      <h1>🎨 Art Gallery</h1>
      <nav>
        <a href={`${import.meta.env.BASE_URL}`}>Home</a>
        <a href={`${import.meta.env.BASE_URL}paintings`}>All Paintings</a>
        <a href={`${import.meta.env.BASE_URL}artists`}>All Artists</a>
      </nav>
    </header>

    <main>
      <section>
        <h2>Featured Paintings</h2>
        <div class="gallery">
          {featuredPaintings.map(painting => (
            <div class="painting-card">
              <a href={`${import.meta.env.BASE_URL}paintings/${painting.data.id}`}>
                <img src={painting.data.imageUrl} alt={painting.data.title} />
                <div class="card-content">
                  <h3>{painting.data.title}</h3>
                  <p class="artist">{artistMap[painting.data.artist] || painting.data.artist}</p>
                  <p class="date">{formatDate(painting.data.date, 'year')}</p>
                </div>
              </a>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2>Featured Artists</h2>
        <div class="artists-grid">
          {artists.slice(0, 6).map(artist => (
            <div class="artist-card">
              <a href={`${import.meta.env.BASE_URL}artists/${artist.data.id}`}>
                {artist.data.image && (
                  <img src={artist.data.image} alt={artist.data.name} />
                )}
                <div class="card-content">
                  <h3>{artist.data.name}</h3>
                  <p class="dates">{formatDateRange(artist.data.birthDate, artist.data.deathDate, 'year')}</p>
                </div>
              </a>
            </div>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  body {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  header {
    text-align: center;
    margin-bottom: 3rem;
  }

  header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  nav {
    display: flex;
    gap: 2rem;
    justify-content: center;
    margin-top: 1rem;
  }

  nav a {
    font-size: 1.1rem;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    transition: background 0.2s;
  }

  nav a:hover {
    background: var(--bg-secondary);
  }

  section {
    margin-bottom: 4rem;
  }

  section h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .gallery, .artists-grid {
    display: grid;
    gap: 2rem;
  }

  .gallery {
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  .artists-grid {
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }

  .painting-card, .artist-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .painting-card:hover, .artist-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 8px 24px var(--shadow);
  }

  .painting-card a, .artist-card a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .painting-card img, .artist-card img {
    width: 100%;
    height: 300px;
    object-fit: cover;
  }

  .card-content {
    padding: 1.5rem;
  }

  .card-content h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.2rem;
    color: var(--text-primary);
  }

  .artist, .date, .dates {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0.25rem 0;
  }

  @media (max-width: 768px) {
    header h1 {
      font-size: 2rem;
    }

    nav {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
